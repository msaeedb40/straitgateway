FROM node:24-alpine AS builder
WORKDIR /app
COPY ui/package*.json ./
RUN npm ci  --no-audit  --no-fund  
COPY ui/ .
RUN npm run build -- --configuration=production
 
FROM nginx:alpine

RUN apk add --no-cache curl  curl-ssl ca-certificates && \  
    rm -rf /usr/share/nginx/html/*  

COPY --from=builder /app/dist/ui/browser /usr/share/nginx/html
RUN  chmod -R 755 /usr/share/nginx/html 
COPY build/nginx.conf /etc/nginx/conf.d/default.conf

HEALTHCHECK --interval=60s --timeout=30s --start-period=5s --retries=5 CMD curl -f http://localhost:80  || exit 1

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
